flowchart TD
    submitOrder["参与者：选择场次票种，确认姓名并提交"] --> eligibilityCheck{"权限、窗口、唯一性及时间冲突校验通过？"}
    eligibilityCheck -->|"否"| orderRejected["拒绝新报名，提示实际原因"]
    eligibilityCheck -->|"是"| allocationCheck{"有可分配名额且无合格在先候补？"}
    allocationCheck -->|"是"| unpaidOrder["未支付：占用一个名额"]
    allocationCheck -->|"否"| waitingOrder["候补中：按场次和票种排队，不占名额"]
    waitingOrder -->|"仍开放且未停售，有名额并轮到本单"| pendingConfirmation["递补待确认：占位并持久化站内通知"]
    pendingConfirmation -->|"实际确认截止前确认"| unpaidOrder
    pendingConfirmation -->|"拒绝、超时、合法取消或活动终止"| cancelledOrder["本单已取消，按实际占位释放名额"]
    waitingOrder -->|"主动放弃、报名截止或活动终止"| cancelledOrder
    unpaidOrder -->|"实际支付截止前确认支付"| paymentResult{"模拟支付成功？"}
    paymentResult -->|"是"| issueTicket["同事务保存成功支付、出票、日志及消息"]
    issueTicket --> enrolledOrder["已报名：沿用原占位，不再次扣名额"]
    enrolledOrder --> subsequentProcess["验票、退款及结束结算，见图5"]
    paymentResult -->|"否：记录本次失败"| retryCheck{"未到期且不同尝试失败不足3次？"}
    retryCheck -->|"是：可发起新尝试"| unpaidOrder
    retryCheck -->|"否"| cancelledOrder
    unpaidOrder -->|"支付截止、合法取消或活动终止"| cancelledOrder
    cancelledOrder -.-> nextCandidate["若仍可售：系统继续处理其他合格候补订单"]
